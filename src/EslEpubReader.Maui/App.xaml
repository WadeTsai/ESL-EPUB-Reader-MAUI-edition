<?xml version="1.0" encoding="utf-8" ?>
<!--
  App.xaml — application-level resources. Light/dark palettes are expressed
  as paired colors consumed via AppThemeBinding in MainPage, so the theme
  toggle recolors the whole UI without a restart.
-->
<Application
    x:Class="EslEpubReader.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Accent used for headers/highlights (matches the app icon). -->
            <Color x:Key="AccentColor">#0F6CBD</Color>
            <Color x:Key="AccentColorDark">#4CC2FF</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
