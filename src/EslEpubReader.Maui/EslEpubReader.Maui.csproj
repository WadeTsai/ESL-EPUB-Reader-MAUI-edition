<!--
  EslEpubReader.Maui.csproj
  =========================
  Cross-platform port of the ESL EPUB Reader, rebuilt on .NET MAUI (the
  successor to the original WinUI 3 app in the sibling repo).

  TARGETS — chosen per BUILD HOST, because Apple's toolchain rules apply:
    * building on Windows produces the WINDOWS app
      (net10.0-windows…; MAUI renders through WinUI 3 underneath);
    * building on macOS produces the MAC app
      (net10.0-maccatalyst; MAUI renders through Mac Catalyst/UIKit).
      Mac Catalyst apps CANNOT be linked or bundled on Windows — Apple's
      linker and SDKs only exist on macOS — hence the per-OS conditions
      instead of one multi-target list.

      To build the Mac binary, on any Mac with .NET 10 + Xcode:
          dotnet workload install maui
          dotnet publish -f net10.0-maccatalyst -c Release
      The .app bundle lands in bin/Release/net10.0-maccatalyst/.

  The Services/ and Models/ layers are byte-for-byte the plain-.NET code
  from the WinUI app (ePub parsing, Bing endpoints, settings), with exactly
  two portability touches: settings live in MAUI's AppDataDirectory, and
  the Windows-only Simplified→Traditional converter no-ops elsewhere.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFrameworks>
    <!-- Linux has no MAUI app head (the Linux app is src/EslEpubReader.Linux),
         but MAUI's platform-agnostic net10.0 TFM compiles every shared
         file — pages, XAML, services — so changes can be checked here
         (needs any MAUI workload, e.g. `dotnet workload install maui-windows`). -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Library</OutputType>
    <RootNamespace>EslEpubReader</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>

    <ApplicationTitle>ESL EPUB Reader</ApplicationTitle>
    <ApplicationId>com.wadetsai.eslepubreader</ApplicationId>
    <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>

    <!-- Windows flavor runs UNPACKAGED so `dotnet run`/plain publish work
         without MSIX plumbing, same choice as the original app. -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon + splash: the open-book-on-blue-tile identity, as SVG so
         MAUI generates every platform size at build time. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#0F6CBD" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F6CBD" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

</Project>
